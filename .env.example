NODE_ENV=development
PORT=4000

# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/joddy

# Comma-separated list of frontend origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Set when the API and frontend share a parent domain in production, e.g. .joddy.app
COOKIE_DOMAIN=

# Shared secret the job scraper sends in the x-ingest-key header
INGEST_API_KEY=change-me-ingest-key-at-least-24-chars

LOG_LEVEL=info
