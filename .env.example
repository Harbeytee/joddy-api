NODE_ENV=development
PORT=4000

# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/joddy

# Comma-separated list of frontend origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Set when the API and frontend share a parent domain in production, e.g. .joddy.app
COOKIE_DOMAIN=

# Shared secret the job scraper sends in the x-ingest-key header
INGEST_API_KEY=change-me-ingest-key-at-least-24-chars

LOG_LEVEL=info

# Apply worker (npm run start:worker). It only clicks "Submit" when this is true;
# otherwise it fills each form, stops and hands the job back as a dry run.
AUTO_APPLY_SUBMIT=false
# How often the worker checks the queue when it's empty, in ms
AUTO_APPLY_POLL_MS=15000
# How often the worker looks for new matches for each user with auto-apply on, in minutes (min 5)
AUTO_APPLY_MATCH_EVERY_MINUTES=60
# Optional: save a screenshot of every form the worker fills (contains applicants' details)
AUTO_APPLY_ARTIFACTS_DIR=

# Job sync (runs in the worker): scrape every board with the job-scraper project and import the
# results. Point this at a checkout of job-scraper; leave empty to import manually (npm run jobs:import).
JOB_SYNC_SCRAPER_DIR=
# How often to scrape and import, in hours
JOB_SYNC_EVERY_HOURS=6
# Stop a scrape that runs longer than this, in minutes
JOB_SYNC_TIMEOUT_MINUTES=240
# Memory for the scraper process, in MB (it keeps every known job in memory)
JOB_SYNC_SCRAPER_MEMORY_MB=6144

# AI features ("Ask AI" job search, resume wording suggestions): a free key from
# https://aistudio.google.com/apikey. Leave empty to hide them.
GEMINI_API_KEY=
# Any Gemini text model; Flash-Lite is free and fast enough for both
GEMINI_MODEL=gemini-3.5-flash-lite
# Daily Gemini calls for the whole app (keep it under your Gemini quota) and per user.
# Both reset at midnight Pacific time.
AI_DAILY_LIMIT=1000
AI_USER_DAILY_LIMIT=50
